# App Environment
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1

# MongoDB development configuration (loopback, isolated database)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=storytool-dev
MONGODB_DB=story_tool_web_dev
MONGODB_TIMEOUT_MS=750

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Phase 03 local web origin
FRONTEND_ORIGIN=http://127.0.0.1:3000
