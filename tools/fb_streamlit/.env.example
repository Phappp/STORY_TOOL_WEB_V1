# FB_TOOL_HOME là BIẾN MÔI TRƯỜNG WINDOWS (setx FB_TOOL_HOME "D:\fb-data"), không đọc từ file .env
# vì chính file .env nằm trong thư mục home đó. Bỏ trống = E:\StoryToolFB-data
# Trong home, các thư mục luôn VIẾT HOA: DATA (fb_tool.db + REFS + IMAGES), LOGS

# API keys cho provider AI (tên biến được tham chiếu bởi ô "Env key" ở Cấu hình ▸ Providers)
OPENROUTER_API_KEY=
TOPTOOLS_API_KEY=

# Tìm ảnh stock (điền key của cái bạn có, không cần cả hai)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Codex CLI (đường dẫn binary nếu không nằm trong PATH)
CODEX_BIN=codex

# yt-dlp cho B0 trích link reel/video Facebook (bỏ trống nếu đã có trong PATH)
YTDLP_BIN=yt-dlp

# Đặt false nếu mạng công ty chặn SSL và truststore không đủ (mặc định true)
HTTP_VERIFY_SSL=true
